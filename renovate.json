{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rangeStrategy": "replace",
  "packageRules": [
    {
      "matchPackagePatterns": ["^astro$", "^@astrojs/"],
      "groupName": "Astro"
    },
    {
      "matchPackagePatterns": ["^msw$", "^@mswjs/"],
      "groupName": "MSW"
    },
    {
      "description": "playwright and @playwright/test must share one playwright-core, or `playwright install` downloads a browser build the other can't launch",
      "matchPackageNames": ["playwright", "@playwright/**"],
      "groupName": "Playwright"
    }
  ]
}
