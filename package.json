{
  "name": "yay-machine-monorepo",
  "version": "0.0.0",
  "description": "A modern, simple, lightweight, zero-dependency, TypeScript state-machine library",
  "type": "module",
  "private": true,
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "all": "bun run fix && bun run check && bun run test && bun run build",
    "check": "bun run check:types && bun run check:lint && bun run check:format",
    "check:types": "turbo check:types",
    "check:lint": "bunx oxlint",
    "check:format": "bunx oxfmt --check",
    "fix": "bun run fix:lint && bun run fix:format",
    "fix:lint": "bunx oxlint --fix",
    "fix:format": "bunx oxfmt --write",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:ci": "turbo run test:ci",
    "bench": "turbo bench",
    "build": "turbo build --concurrency=1",
    "docs:sync": "bun run scripts/sync-docs.ts",
    "site:dev": "bun run --filter @yay-machine/site dev",
    "site:build": "bun run --filter @yay-machine/site build",
    "site:preview": "bun run --filter @yay-machine/site preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurice/yay-machine.git"
  },
  "keywords": [
    "state-machine",
    "fsm",
    "state-management",
    "lightweight",
    "zero-dependency",
    "typescript",
    "browser",
    "server",
    "concise",
    "declarative",
    "deterministic",
    "safe",
    "yay"
  ],
  "author": "maurice@mauricenicholson.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/maurice/yay-machine/issues"
  },
  "homepage": "https://github.com/maurice/yay-machine#readme",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@sinonjs/fake-timers": "^15.0.0",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.2",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.59.0",
    "playwright": "^1.53.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.0",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": "24.x"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
