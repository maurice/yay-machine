---
// Renders a benchmark chart generated by `bun run bench:report`.
// The SVG is inlined so it picks up the theme's --bench-* colors (custom.css).
interface Props {
  readonly name: string;
}

const sources = import.meta.glob<string>("../../assets/bench/*.svg", {
  eager: true,
  query: "?raw",
  import: "default",
});

const { name } = Astro.props;
const source = sources[`../../assets/bench/${name}.svg`];
if (!source) {
  throw new Error(
    `Unknown benchmark chart "${name}", run \`bun run bench:report\``,
  );
}
---

<figure class="bench-chart" set:html={source} />

<style>
  .bench-chart {
    margin: 1.5rem 0;
  }
  .bench-chart :global(svg) {
    display: block;
    width: 100%;
    max-width: 820px;
    height: auto;
  }
</style>
